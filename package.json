{
  "name": "datafuturex-note",
  "version": "1.0.0",
  "description": "DataFutureX Note - 本地优先的桌面 Markdown 笔记软件",
  "main": "dist-electron/main/index.js",
  "author": "DataFutureX",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs full",
    "build:dir": "node scripts/build.mjs dir",
    "build:vite": "vite build",
    "pack": "node scripts/build.mjs pack",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "selfcheck": "vitest run tests/fsService.integration.test.ts tests/pathSafety.test.ts tests/appPaths.test.ts tests/markdownOutline.test.ts",
    "icon": "node scripts/generate-icon.mjs",
    "prepare:electron": "node scripts/prepare-electron-runtime.mjs",
    "postinstall": "node scripts/sync-vditor.mjs && node scripts/prepare-electron-runtime.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language": "^6.10.6",
    "@codemirror/state": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.35.0",
    "@element-plus/icons-vue": "^2.3.1",
    "adm-zip": "^0.5.16",
    "docx": "^9.1.0",
    "dompurify": "^3.2.3",
    "element-plus": "^2.9.1",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "pinia": "^2.3.0",
    "vditor": "^3.10.9",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/dompurify": "^3.2.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^44.7.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "com.datafuturex.note",
    "productName": "DataFutureX Note",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/icon.ico",
      "resources/icon.png",
      "resources/tray-16.png",
      "resources/tray-32.png"
    ],
    "extraResources": [
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/tray-16.png",
        "to": "tray-16.png"
      },
      {
        "from": "resources/tray-32.png",
        "to": "tray-32.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DataFutureX Note",
      "uninstallDisplayName": "DataFutureX Note",
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "vue-demi@0.14.10": true,
    "electron@44.7.0": true
  }
}
